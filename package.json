{
  "name": "@rally-fun/sdk",
  "version": "0.1.0",
  "description": "Launch and trade Rally coins from any app — headless TypeScript SDK for the Rally launchpad (Uniswap v4 bonding curve + graduation).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rally",
    "launchpad",
    "memecoin",
    "uniswap-v4",
    "bonding-curve",
    "evm",
    "viem",
    "defi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/longshot-fun/cohort-apps.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync:deployments": "node scripts/sync-deployments.mjs",
    "prepublishOnly": "yarn build && yarn test"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "viem": "^2.46.2",
    "vitest": "^2.1.9"
  }
}
